APP_NAME=GlowBook
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=glowbook_laravel_dev
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
LOG_CHANNEL=stack
LOG_LEVEL=warning

# MoMo: keep disabled until sandbox acceptance and a public HTTPS APP_URL are configured.
MOMO_ENABLED=false
MOMO_ENVIRONMENT=sandbox
MOMO_BUSINESS_ID=0
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
