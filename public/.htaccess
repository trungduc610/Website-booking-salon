Options -Indexes

# Chuyển hướng tất cả request về public/index.php (Front Controller)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Nếu đang request file/thư mục thật thì không redirect
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Chuyển về index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Chặn truy cập file ẩn (.env, .git, .htaccess)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
